---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Production - Budapest Hardware Club">
  <Navigation />
  <main id="top">

    <section class="hero">
      <div class="wrap">
        <span class="eyebrow">// <span class="en">production services</span><span class="hu">gyártási szolgáltatások</span></span>
        <h1><span class="en"><span class="accent">Parts made to order</span></span><span class="hu"><span class="accent">Alkatrészgyártás rendelésre</span></span></h1>
        <p class="lead"><span class="en">3D printing, laser cutting, CAD design and electronics. Tell us what you need made. We’ll reply with a price and delivery date.</span><span class="hu">3D nyomtatás, lézervágás, CAD-tervezés és elektronika. Írd meg, mit szeretnél gyártatni. Árral és szállítási határidővel válaszolunk.</span></p>
        <div class="btns">
          <a class="btn primary" href="#request"><span class="en">Send a job</span><span class="hu">Munkát küldök</span></a>
          <a class="btn ghost" href="#prices"><span class="en">Starting prices</span><span class="hu">Kezdő árak</span></a>
        </div>
      </div>
    </section>

    <section id="processes">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">// <span class="en">processes</span><span class="hu">folyamatok</span></span>
          <h2><span class="en">Choose a service</span><span class="hu">Válassz szolgáltatást</span></h2>
          <p><span class="en">Send a model, drawing or description of your project.</span><span class="hu">Küldj modellt, rajzot vagy projektleírást.</span></p>
        </div>
        <div class="cards process-tiles">
          <a class="card process-tile" href="#request" data-process="3D printing">
            <div class="ic">🖨</div>
            <h3><span class="en">Print</span><span class="hu">Nyomtatás</span></h3>
            <p><span class="en">FDM printing in PLA, PETG or TPU. Accepts STL, 3MF and STEP files.</span><span class="hu">FDM nyomtatás PLA, PETG vagy TPU anyagból. STL, 3MF és STEP fájlokat fogadunk.</span></p>
            <span class="tile-link"><span class="en">Request a print →</span><span class="hu">FDM →</span></span>
          </a>
          <a class="card process-tile" href="#request" data-process="Laser">
            <div class="ic">🔦</div>
            <h3><span class="en">Laser</span><span class="hu">Lézer</span></h3>
            <p><span class="en">Cutting and engraving wood and plywood with a 20 W diode laser.</span><span class="hu">Fa és rétegelt lemez vágása és gravírozása 20 W-os diódalézerrel.</span></p>
            <span class="tile-link"><span class="en">Request laser work →</span><span class="hu">Lézer →</span></span>
          </a>
          <a class="card process-tile" href="#request" data-process="CAD design">
            <div class="ic">📐</div>
            <h3><span class="en">CAD</span><span class="hu">CAD</span></h3>
            <p><span class="en">Part design and a first print, including one agreed revision.</span><span class="hu">Alkatrésztervezés és első nyomtatás, egy egyeztetett módosítással.</span></p>
            <span class="tile-link"><span class="en">Request CAD →</span><span class="hu">CAD kérés →</span></span>
          </a>
          <a class="card process-tile" href="#request" data-process="Electronics">
            <div class="ic">🔌</div>
            <h3><span class="en">Electronics</span><span class="hu">Elektronika</span></h3>
            <p><span class="en">Boards, wiring and firmware. Starts with a paid planning session.</span><span class="hu">Panelek, bekötés és firmware. Fizetett tervezési egyeztetéssel kezdünk.</span></p>
            <span class="tile-link"><span class="en">Discuss your project →</span><span class="hu">Elektronika →</span></span>
          </a>
        </div>
      </div>
    </section>


    <section id="prices">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">// <span class="en">starting prices</span><span class="hu">kezdő árak</span></span>
          <h2><span class="en">Prices</span><span class="hu">Árak</span></h2>
          <p><span class="en">These are minimum prices. We review your requirements and agree on the final price before starting.</span><span class="hu">Ezek minimumárak. Az igények áttekintése után, a munka kezdete előtt egyeztetjük a végleges árat.</span></p>
        </div>

        <div class="price-table" role="table" aria-label="Starting prices">
          <div class="price-row price-head" role="row">
            <span role="columnheader"><span class="en">Process</span><span class="hu">Folyamat</span></span>
            <span role="columnheader"><span class="en">From</span><span class="hu">Ettől</span></span>
            <span role="columnheader"><span class="en">Note</span><span class="hu">Megjegyzés</span></span>
          </div>
          <div class="price-row" role="row">
            <span role="cell"><span class="en">3D printing</span><span class="hu">3D nyomtatás</span></span>
            <span class="n" role="cell">7 900 Ft</span>
            <span role="cell"><span class="en">Per order, ex-VAT · PLA / PETG / TPU</span><span class="hu">Megrendelésenként, nettó · PLA / PETG / TPU</span></span>
          </div>
          <div class="price-row" role="row">
            <span role="cell"><span class="en">Laser</span><span class="hu">Lézer</span></span>
            <span class="n" role="cell">9 900 Ft</span>
            <span role="cell"><span class="en">Per order, ex-VAT · wood / plywood</span><span class="hu">Megrendelésenként, nettó · fa / rétegelt</span></span>
          </div>
          <div class="price-row" role="row">
            <span role="cell"><span class="en">CAD + first print</span><span class="hu">CAD + első nyomtatás</span></span>
            <span class="n" role="cell">40 000 Ft</span>
            <span role="cell"><span class="en">Per part, ex-VAT · one revision</span><span class="hu">Alkatrészenként, nettó · egy javítás</span></span>
          </div>
          <div class="price-row" role="row">
            <span role="cell"><span class="en">Electronics scoping</span><span class="hu">Elektronikai tervezés</span></span>
            <span class="n" role="cell">30 000 Ft</span>
            <span role="cell"><span class="en">Two-hour planning session, ex-VAT</span><span class="hu">Kétórás tervezés, nettó</span></span>
          </div>
        </div>

        <p class="note"><span class="en">Club members: say so in the form. Pickup in Budapest, or parcel delivery in Hungary and the EU.</span><span class="hu">Klubtagok: írjátok meg az űrlapon. Átvétel Budapesten vagy csomagküldés Magyarországon és az EU-ban.</span></p>
      </div>
    </section>

    <section id="how">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">// <span class="en">how it works</span><span class="hu">hogyan működik</span></span>
          <h2><span class="en">How it works</span><span class="hu">Hogyan működik</span></h2>
        </div>
        <div class="cards">
          <div class="card"><div class="ic">01</div><h3><span class="en">Send the brief</span><span class="hu">Küldd el a leírást</span></h3><p><span class="en">File, sketch or the broken part itself.</span><span class="hu">Fájl, vázlat vagy maga a törött alkatrész.</span></p></div>
          <div class="card"><div class="ic">02</div><h3><span class="en">Fixed price and date</span><span class="hu">Rögzített ár és határidő</span></h3><p><span class="en">We reply within one working day.</span><span class="hu">Egy munkanapon belül válaszolunk.</span></p></div>
          <div class="card"><div class="ic">03</div><h3><span class="en">Approval, then production</span><span class="hu">Jóváhagyás, aztán gyártás</span></h3><p><span class="en">You approve the first part before we make the rest.</span><span class="hu">Az első darabot jóváhagyod; utána indul a széria.</span></p></div>
          <div class="card"><div class="ic">04</div><h3><span class="en">Pickup or shipping</span><span class="hu">Átvétel vagy szállítás</span></h3><p><span class="en">Budapest pickup by arrangement, or parcel delivery.</span><span class="hu">Átvétel Budapesten megbeszélés szerint, vagy csomagküldés.</span></p></div>
        </div>
      </div>
    </section>

    <section id="request">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">// <span class="en">request</span><span class="hu">megrendelés</span></span>
          <h2><span class="en">Send a job</span><span class="hu">Küldj munkát</span></h2>
          <p><span class="en">Describe the part, its dimensions, quantity and when you need it.</span><span class="hu">Írd le az alkatrészt, a méreteit, a darabszámot és a kért határidőt.</span></p>
        </div>

        <form class="form" id="jobform">
          <div class="pick">
            <label>
              <input type="radio" name="entry" value="file" checked />
              <span><span class="en">I have a file</span><span class="hu">Van fájlom</span></span>
            </label>
            <label>
              <input type="radio" name="entry" value="design" />
              <span><span class="en">I need it designed</span><span class="hu">Meg kell tervezni</span></span>
            </label>
            <label>
              <input type="radio" name="entry" value="electronics" />
              <span><span class="en">Electronics and firmware</span><span class="hu">Elektronika és firmware</span></span>
            </label>
          </div>

          <div class="pair">
            <div class="field">
              <label for="process"><span class="en">Process</span><span class="hu">Folyamat</span></label>
              <select id="process" name="process">
                <option value="3D printing" data-en="3D printing" data-hu="3D nyomtatás">3D printing</option>
                <option value="Laser" data-en="Laser cutting or engraving" data-hu="Lézervágás vagy gravírozás">Laser cutting or engraving</option>
                <option value="Print + laser" data-en="Printing and laser" data-hu="Nyomtatás és lézer">Printing and laser</option>
                <option value="CAD design" data-en="CAD design" data-hu="CAD tervezés">CAD design</option>
                <option value="Electronics" data-en="Electronics and firmware" data-hu="Elektronika és firmware">Electronics and firmware</option>
                <option value="Not sure" data-en="Not sure - recommend" data-hu="Nem tudom - javasoljatok">Not sure - recommend</option>
              </select>
            </div>
            <div class="field">
              <label for="material"><span class="en">Material</span><span class="hu">Anyag</span> <span class="opt"><span class="en">optional</span><span class="hu">nem kötelező</span></span></label>
              <input id="material" name="material" placeholder="PLA, PETG, wood…" />
            </div>
          </div>

          <div class="pair">
            <div class="field">
              <label for="quantity"><span class="en">How many</span><span class="hu">Mennyi</span></label>
              <input id="quantity" name="quantity" inputmode="numeric" placeholder="1" />
            </div>
            <div class="field">
              <label for="timeline"><span class="en">When you need it</span><span class="hu">Mikorra kell</span></label>
              <input id="timeline" name="timeline" placeholder="This week / no rush" />
            </div>
          </div>

          <div class="field">
            <label for="application"><span class="en">What you need</span><span class="hu">Mire van szükséged</span></label>
            <textarea id="application" name="application" required placeholder="Describe the part, how it will be used, and any dimensions or load requirements."></textarea>
          </div>

          <div class="field">
            <label for="files"><span class="en">Files</span><span class="hu">Fájlok</span> <span class="opt"><span class="en">optional, up to 6</span><span class="hu">nem kötelező, max 6</span></span></label>
            <input id="files" name="files" type="file" multiple accept=".stl,.3mf,.step,.stp,.iges,.igs,.obj,.dxf,.svg,.pdf,.png,.jpg,.jpeg,.zip" />
            <p class="hint"><span class="en">STL, 3MF, STEP, DXF, SVG, PDF, photos or a ZIP - up to 6 files, 25 MB each.</span><span class="hu">STL, 3MF, STEP, DXF, SVG, PDF, fotó vagy ZIP - max 6 fájl, egyenként 25 MB.</span></p>
          </div>

          <div class="pair">
            <div class="field">
              <label for="name"><span class="en">Name</span><span class="hu">Név</span></label>
              <input id="name" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email"><span class="en">Email</span><span class="hu">E-mail</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div class="pair">
            <div class="field">
              <label for="org"><span class="en">Company</span><span class="hu">Cég</span> <span class="opt"><span class="en">optional</span><span class="hu">nem kötelező</span></span></label>
              <input id="org" name="org" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="budget"><span class="en">Budget</span><span class="hu">Költségkeret</span> <span class="opt"><span class="en">optional</span><span class="hu">nem kötelező</span></span></label>
              <input id="budget" name="budget" placeholder="" />
            </div>
          </div>

          <div class="foot">
            <button class="btn primary" type="submit"><span class="en">Send the brief</span><span class="hu">Elküldöm</span></button>
            <span class="hint"><span class="en">We’ll send a quote for your approval.</span><span class="hu">Árajánlatot küldünk jóváhagyásra.</span></span>
          </div>
          <p class="formmsg" id="formmsg" hidden></p>
        </form>

      </div>
    </section>

  </main>
  <Footer />

  <style>
    .hero .wrap{text-align:left;max-width:var(--maxw)}
    .hero h1{font-size:clamp(2rem,5vw,3.4rem);line-height:1.05;margin:.35em 0 .1em;letter-spacing:-.02em}
    .hero p.lead{margin:14px 0 0;max-width:640px}
    .hero .btns{justify-content:flex-start;margin-top:28px}
    .sec-head p{max-width:640px}
    .process-tiles a.card{color:inherit;transition:border-color .15s,box-shadow .15s}
    .process-tiles a.card:hover{border-color:var(--accent);box-shadow:0 12px 28px -18px rgba(13,27,42,.28)}
    .process-tiles .tile-link{display:inline-block;margin-top:14px;font-weight:600;font-size:.9rem;color:var(--accent-2)}
    .price-table{display:grid;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--card)}
    .price-row{display:grid;grid-template-columns:1.2fr .7fr 1.6fr;gap:16px;align-items:baseline;padding:16px 20px;border-bottom:1px solid var(--line)}
    .price-row:last-child{border-bottom:0}
    .price-head{background:var(--bg-soft);font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
    .price-row .n{font-family:var(--mono);font-size:1.02rem;white-space:nowrap}
    @media(max-width:640px){.price-row{grid-template-columns:1fr;gap:4px}.price-head{display:none}.price-row .n{margin:2px 0}}
    .note{color:var(--muted);font-size:.92rem;max-width:70ch;margin-top:22px}
    .note a{color:var(--accent-2)}
    .form{display:grid;gap:20px;max-width:680px}
    .pair{display:grid;gap:20px}
    @media(min-width:640px){.pair{grid-template-columns:1fr 1fr}}
    .field{display:grid;gap:7px;min-width:0}
    .field label{font-family:var(--mono);font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
    .field .opt{letter-spacing:.02em;text-transform:none;font-size:.72rem;color:#9fb0c0}
    .field input,.field textarea,.field select{width:100%;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);font-family:var(--sans);font-size:1rem;padding:11px 13px;transition:border-color .15s}
    .field textarea{min-height:96px;resize:vertical}
    .field input:focus,.field textarea:focus,.field select:focus{outline:none;border-color:var(--accent)}
    .field .hint{font-size:.82rem;color:var(--muted);margin:0}
    .pick{display:grid;gap:12px}
    @media(min-width:760px){.pick{grid-template-columns:repeat(3,1fr)}}
    .pick label{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:12px;padding:14px 16px;cursor:pointer;background:var(--card);font-weight:600;font-size:.95rem;transition:border-color .15s}
    .pick label:hover{border-color:var(--accent)}
    .pick label:has(input:checked){border-color:var(--accent);box-shadow:0 0 0 1px var(--accent) inset}
    .pick input{accent-color:var(--accent);margin:0}
    .foot{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
    .formmsg{margin:0;font-size:.95rem}
    .formmsg.good{color:var(--accent-2)}
    .formmsg.bad{color:#b42318}
  </style>

  <script>
    // The form is two requests on purpose: files go to /api/upload, then the
    // brief goes to /api/request citing their keys. If the upload fails the
    // brief is still sent - a request without files is a lead, and a failed
    // upload is not worth losing one over. The sender is told what happened.
    (() => {
      const form = document.getElementById('jobform');
      const button = form.querySelector('button[type=submit]');
      const msg = document.getElementById('formmsg');
      const fileField = document.getElementById('files');
      const label = button.innerHTML;

      const T = {
        sending: { en: 'Sending…', hu: 'Küldés…' },
        uploading: { en: 'Uploading…', hu: 'Feltöltés…' },
        sent: {
          en: 'Sent. We answer within one working day, with a fixed price and a date.',
          hu: 'Elküldve. Egy munkanapon belül válaszolunk, rögzített árral és határidővel.'
        },
        tooMany: { en: 'Up to 6 files per request.', hu: 'Legfeljebb 6 fájl küldhető.' },
        tooBig: { en: 'A file is larger than 25 MB.', hu: 'Egy fájl nagyobb, mint 25 MB.' },
        noAttach: {
          en: ' Your files did not attach — email them to hello@bhw.hu and quote your name.',
          hu: ' A fájlok nem csatolódtak — küldd el őket a hello@bhw.hu címre, a neved megadásával.'
        },
        fallback: { en: ' — or write to hello@bhw.hu directly.', hu: ' — vagy írj közvetlenül a hello@bhw.hu címre.' }
      };
      const lang = () => (document.documentElement.getAttribute('data-lang') === 'hu' ? 'hu' : 'en');
      const t = (key) => T[key][lang()];

      const say = (text, bad) => {
        msg.textContent = text;
        msg.className = 'formmsg ' + (bad ? 'bad' : 'good');
        msg.hidden = false;
      };

      // A select cannot carry .en/.hu spans, so the option text is swapped on
      // the same language event the header buttons dispatch.
      const swapOptions = () => {
        const language = lang();
        for (const option of document.getElementById('process').options) {
          option.textContent = option.dataset[language] || option.textContent;
        }
      };
      swapOptions();
      document.addEventListener('bhw-lang-change', swapOptions);

      const processSelect = document.getElementById('process');
      const applyProcess = (value) => {
        if (!value || !processSelect) return;
        const match = [...processSelect.options].find((o) => o.value === value);
        if (match) processSelect.value = value;
      };
      const params = new URLSearchParams(window.location.search);
      applyProcess(params.get('process'));

      document.querySelectorAll('[data-process]').forEach((el) => {
        el.addEventListener('click', () => applyProcess(el.getAttribute('data-process')));
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        msg.hidden = true;

        const picked = [...(fileField.files || [])];
        if (picked.length > 6) return say(t('tooMany'), true);
        if (picked.some((file) => file.size > 25 * 1024 * 1024)) return say(t('tooBig'), true);

        button.disabled = true;
        button.textContent = t('sending');

        const body = Object.fromEntries(new FormData(form).entries());
        delete body.files; // File objects, replaced by the R2 keys below

        let warning = '';
        if (picked.length) {
          button.textContent = t('uploading');
          try {
            const upload = new FormData();
            for (const file of picked) upload.append('files', file);
            const response = await fetch('/api/upload', { method: 'POST', body: upload });
            const data = await response.json();
            if (!data || !data.ok) throw new Error((data && data.error) || 'upload failed');
            body.files = data.files.map((file) => file.key);
          } catch {
            warning = t('noAttach');
          }
          button.textContent = t('sending');
        }

        try {
          const response = await fetch('/api/request', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(body)
          });
          const data = await response.json();
          if (!data || !data.ok) throw new Error((data && data.error) || 'could not send');
          form.reset();
          swapOptions();
          say(t('sent') + warning, false);
        } catch (error) {
          say(error.message + t('fallback'), true);
        } finally {
          button.disabled = false;
          button.innerHTML = label;
        }
      });
    })();
  </script>
</BaseLayout>
