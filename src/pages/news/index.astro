---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Navigation from '../../components/Navigation.astro';

const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="News · Budapest Hardware Club">
  <Navigation />
  <main class="news-page"><section><div class="wrap"><div class="sec-head"><h1><span class="en">From the club</span><span class="hu">A klubból</span></h1><p><span class="en">News, events and reports from Budapest Hardware Club.</span><span class="hu">Hírek, események és beszámolók a Budapest Hardware Clubtól.</span></p></div><div class="news-grid">{posts.map((post) => (<article class="news-card">{post.data.image && <a class="news-card-image" href={`/news/${post.slug}/`}><img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} width="1200" height="630" loading="lazy" decoding="async" /></a>}<span class="badge"><span class="en">{post.data.badge}</span><span class="hu">{post.data.badgeHu}</span></span><h2><a href={`/news/${post.slug}/`}><span class="en">{post.data.title}</span><span class="hu">{post.data.titleHu}</span></a></h2><p><span class="en">{post.data.description}</span><span class="hu">{post.data.descriptionHu}</span></p><a class="readmore" href={`/news/${post.slug}/`}><span class="en">Read the article →</span><span class="hu">Cikk megnyitása →</span></a></article>))}</div></div></section></main>
  <Footer />
</BaseLayout>
