---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import projects from '../../data/memberProjects.json';

export function getStaticPaths() {
  return projects.filter((project) => project.published).map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
---
<BaseLayout
  title={project.name + ' · Member projects · Budapest Hardware Club'}
  description={project.summary.en}
  ogTitle={project.name + ' · BHW Member Projects'}
  ogDescription={project.summary.en}
  image={'https://bhw.hu' + project.image}
>
  <Navigation />
  <main class="project-detail">
    <div class="wrap">
      <nav class="project-breadcrumb" aria-label="Breadcrumb">
        <a href="/projects/"><span class="en">← Member projects</span><span class="hu">← Tagjaink projektjei</span></a>
        <span aria-hidden="true">/</span> {project.name}
      </nav>
      <header class="project-detail-header">
        <p class="eyebrow"><span class="en">{project.category.en} / Community showcase</span><span class="hu">{project.category.hu} / Közösségi bemutató</span></p>
        <h1>{project.name}<span class="title-dot">.</span></h1>
        <p class="project-detail-lead en">{project.summary.en}</p>
        <p class="project-detail-lead hu">{project.summary.hu}</p>
        <div class="project-detail-meta">
          <div><span class="project-detail-label"><span class="en">Created by</span><span class="hu">Készítette</span></span><strong>{project.creator}</strong></div>
          <div><span class="project-detail-label"><span class="en">Technology</span><span class="hu">Technológia</span></span><strong>{project.tags.slice(0, 3).join(' / ')}</strong></div>
        </div>
        <div class="btns">
          <a class="btn primary" href={project.site} target="_blank" rel="noopener noreferrer"><span class="en">Visit project website ↗</span><span class="hu">Projekt weboldala ↗</span></a>
          <a class="btn ghost" href={project.videos} target="_blank" rel="noopener noreferrer"><span class="en">Watch demos ↗</span><span class="hu">Bemutatók ↗</span></a>
        </div>
      </header>
      <figure class="project-detail-main-image">
        <img src={project.image} alt={project.imageAlt} width="1200" height="587" decoding="async" fetchpriority="high" />
        <figcaption><span class="en">Project image provided by the maker's website.</span><span class="hu">A projekt képe az alkotó weboldaláról származik.</span></figcaption>
      </figure>
      <section class="project-about">
        <div class="project-about-title">
          <p class="eyebrow"><span class="en">Inside the project</span><span class="hu">A projektről</span></p>
          <h2><span class="en">What it does</span><span class="hu">Mit tud?</span></h2>
        </div>
        <div class="project-about-body">
          <p class="en">{project.description.en}</p>
          <p class="hu">{project.description.hu}</p>
        </div>
      </section>
      <section class="project-features" aria-label="Features">
        {project.features.map((feature, index) => (
          <div class="project-feature">
            <span class="project-feature-index">{String(index + 1).padStart(2, '0')}</span>
            <h3><span class="en">{feature.title.en}</span><span class="hu">{feature.title.hu}</span></h3>
            <p class="en">{feature.body.en}</p>
            <p class="hu">{feature.body.hu}</p>
          </div>
        ))}
      </section>
      <div class="project-detail-secondary">
        <figure>
          <img src={project.secondaryImage} alt={project.secondaryImageAlt} loading="lazy" width="1600" height="900" decoding="async" />
          <figcaption><span class="en">USB Live demo preview. Available only on supported displays.</span><span class="hu">USB Live bemutató. Csak támogatott kijelzőkön használható.</span></figcaption>
        </figure>
        <div class="project-detail-secondary-copy">
          <p class="eyebrow"><span class="en">From browser to board</span><span class="hu">A böngészőtől a hardverig</span></p>
          <h2><span class="en">See the interface on real hardware.</span><span class="hu">Nézd meg a felületet valódi hardveren.</span></h2>
          <p class="en">USB Live can mirror the editor to supported ESP32 displays. For a finished project, export the Arduino source and board drivers.</p>
          <p class="hu">A USB Live támogatott ESP32-kijelzőkre tükrözi a szerkesztőt. A kész projekthez exportálható az Arduino-forráskód és a meghajtók.</p>
          <a class="text-link" href={project.site} target="_blank" rel="noopener noreferrer"><span class="en">Learn more from the maker ↗</span><span class="hu">További információ az alkotótól ↗</span></a>
        </div>
      </div>
      <aside class="project-bottom-cta">
        <div>
          <p class="eyebrow"><span class="en">Your project could be next</span><span class="hu">A te projekted lehet a következő</span></p>
          <h2><span class="en">Show us what you're building.</span><span class="hu">Mutasd meg, min dolgozol.</span></h2>
        </div>
        <a class="btn primary" href="mailto:hello@bhw.hu?subject=BHW%20member%20project"><span class="en">Submit a project →</span><span class="hu">Projekt beküldése →</span></a>
      </aside>
    </div>
  </main>
  <Footer />
</BaseLayout>
