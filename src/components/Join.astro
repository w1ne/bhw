<section id="join"><div class="wrap contact-row">
  <div class="join-col">
    <h2><span class="en">Join the association</span><span class="hu">Csatlakozz az egyesülethez</span></h2>
    <div class="carousel" data-carousel>
      <div class="carousel-frame">
        <div class="carousel-track">
          <img src="/images/join.webp" alt="Members working together on laptops and hardware" width="1600" height="974" decoding="async" />
          <img src="/images/join-2.webp" alt="Members at another table working on laptops and hardware" width="1600" height="1067" decoding="async" />
          <img src="/images/hackathon-cover.webp" alt="A group gathered around a table of hardware parts at the hackathon" width="1600" height="1067" decoding="async" />
        </div>
        <button class="carousel-btn carousel-prev" type="button" data-en="Previous photo" data-hu="Előző kép" aria-label="Previous photo">‹</button>
        <button class="carousel-btn carousel-next" type="button" data-en="Next photo" data-hu="Következő kép" aria-label="Next photo">›</button>
      </div>
      <div class="carousel-dots">
        <button type="button" data-en="Photo 1" data-hu="1. kép" aria-label="Photo 1" aria-current="true"></button>
        <button type="button" data-en="Photo 2" data-hu="2. kép" aria-label="Photo 2"></button>
        <button type="button" data-en="Photo 3" data-hu="3. kép" aria-label="Photo 3"></button>
      </div>
    </div>
  </div>
  <div>
    <p class="what"><span class="en">Meetups, workshops, hackathons, and help on hardware projects.</span><span class="hu">Meetupok, workshopok, hackathonok, és segítség hardverprojektekben.</span></p>
    <ul class="benefits">
      <li><span class="en">Priority access to events and workshops</span><span class="hu">Elsőbbség eseményeken és workshopokon</span></li>
      <li><span class="en">Member pricing for fabrication</span><span class="hu">Tagi ár a gyártásra</span></li>
      <li><span class="en">Member channels on Discord</span><span class="hu">Tagi csatornák Discordon</span></li>
      <li><span class="en">A vote on decisions</span><span class="hu">Szavazat a döntéseknél</span></li>
      <li><span class="en">Sponsorships and investments</span><span class="hu">Szponzoráció és befektetések</span></li>
    </ul>
    <form class="form" id="joinform" method="post" action="/api/join">
      <div class="pair">
        <div class="field">
          <label for="join-name"><span class="en">Name</span><span class="hu">Név</span></label>
          <input id="join-name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="join-email"><span class="en">Email</span><span class="hu">E-mail</span></label>
          <input id="join-email" name="email" type="email" autocomplete="email" required />
        </div>
      </div>
      <input class="hp" type="text" name="bhw_hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="foot">
        <button class="btn primary" type="submit"><span class="en">Join</span><span class="hu">Csatlakozom</span></button>
      </div>
      <p class="formmsg" id="joinmsg" role="status" aria-live="polite" hidden></p>
    </form>
    <p class="consent"><span class="en">We'll email you. Questions: </span><span class="hu">Írunk neked. Kérdés: </span><a href="mailto:hello@bhw.hu">hello@bhw.hu</a></p>
  </div>
</div>
</section>

<style>
  .form{display:grid;gap:20px;max-width:680px;margin:22px 0 0}
  .pair{display:grid;gap:20px}
  @media(min-width:640px){.pair{grid-template-columns:1fr 1fr}}
  .field{display:grid;gap:7px;min-width:0}
  .field label{font-family:var(--mono);font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .field input{width:100%;border:1px solid var(--line);border-radius:4px;background:var(--card);color:var(--ink);font-family:var(--sans);font-size:1rem;padding:11px 13px;transition:border-color .15s}
  .field input:focus{outline:none;border-color:var(--accent)}
  .what{color:var(--ink);max-width:62ch}
  .benefits{margin:0;padding-left:18px;max-width:62ch;color:var(--ink)}
  .benefits li{margin:8px 0}
  .hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
  .foot{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
  .formmsg{margin:0;font-size:.95rem}
  .formmsg.good{color:var(--accent-2)}
  .formmsg.bad{color:#b42318}
  .consent{font-size:.82rem;color:var(--muted);margin:18px 0 0;max-width:60ch}
  .join-col{display:grid;align-content:start;gap:18px}
  .carousel{margin:0;max-width:260px}
  .carousel-frame{position:relative}
  .carousel-track{display:flex;align-items:flex-start;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}
  .carousel-track::-webkit-scrollbar{display:none}
  .carousel-track{background:var(--bg)}
  .carousel-track img{flex:0 0 100%;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;scroll-snap-align:start;scroll-snap-stop:always;display:block}
  .carousel-btn{position:absolute;top:50%;transform:translateY(-50%);width:28px;height:28px;border:0;border-radius:50%;background:rgba(255,255,255,.92);color:var(--ink);font-size:18px;line-height:1;cursor:pointer}
  .carousel-prev{left:12px}
  .carousel-next{right:12px}
  .carousel-dots{display:flex;justify-content:center;gap:8px;margin-top:12px}
  .carousel-dots button{width:8px;height:8px;padding:0;border:0;border-radius:50%;background:var(--line);cursor:pointer}
  .carousel-dots button[aria-current="true"]{background:var(--ink)}
</style>

<script>
  (() => {
    const form = document.getElementById('joinform');
    const button = form && form.querySelector('button[type=submit]');
    const msg = document.getElementById('joinmsg');
    if (!form || !button || !msg) return;
    const label = button.innerHTML;

    const T = {
      sending: { en: 'Sending…', hu: 'Küldés…' },
      done: { en: "Thanks — we'll email you.", hu: 'Köszönjük — írunk neked.' },
      bad: { en: 'Something went wrong — write to hello@bhw.hu.', hu: 'Valami hiba történt — írj a hello@bhw.hu címre.' }
    };
    const lang = () => (document.documentElement.getAttribute('data-lang') === 'hu' ? 'hu' : 'en');
    const t = (key) => T[key][lang()];

    const say = (text, bad) => {
      msg.textContent = text;
      msg.className = 'formmsg ' + (bad ? 'bad' : 'good');
      msg.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      msg.hidden = true;
      button.disabled = true;
      button.textContent = t('sending');

      try {
        const body = Object.fromEntries(new FormData(form).entries());
        const response = await fetch('/api/join', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await response.json().catch(() => null);
        if (!response.ok || !data || !data.ok) throw new Error();
        form.reset();
        say(t('done'), false);
      } catch {
        say(t('bad'), true);
      } finally {
        button.disabled = false;
        button.innerHTML = label;
      }
    });
  })();

  (() => {
    const root = document.querySelector('[data-carousel]');
    if (!root) return;
    const track = root.querySelector('.carousel-track');
    const slides = [...track.querySelectorAll('img')];
    const dots = [...root.querySelectorAll('.carousel-dots button')];
    const label = (el) => {
      const language = document.documentElement.getAttribute('data-lang') === 'hu' ? 'hu' : 'en';
      el.setAttribute('aria-label', el.dataset[language] || el.getAttribute('aria-label'));
    };
    const labels = () => {
      root.querySelectorAll('[data-en]').forEach(label);
    };
    const index = () => Math.round(track.scrollLeft / (track.clientWidth || 1));
    const go = (i) => {
      const n = (i + slides.length) % slides.length;
      track.scrollTo({ left: n * track.clientWidth, behavior: 'smooth' });
    };
    const mark = () => {
      const current = index();
      dots.forEach((dot, n) => dot.setAttribute('aria-current', n === current ? 'true' : 'false'));
    };
    const stop = () => clearInterval(timer);
    let timer;
    const start = () => {
      stop();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = setInterval(() => go(index() + 1), 4000);
    };
    root.querySelector('.carousel-prev').addEventListener('click', () => { go(index() - 1); start(); });
    root.querySelector('.carousel-next').addEventListener('click', () => { go(index() + 1); start(); });
    dots.forEach((dot, n) => dot.addEventListener('click', () => { go(n); start(); }));
    track.addEventListener('scroll', mark, { passive: true });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
    document.addEventListener('bhw-lang-change', labels);
    labels();
    mark();
    start();
  })();
</script>
