---
import '../styles/conversations.css';

// Newest first. Every episode renders with the same card.
const episodes = [
  {
    slug: 'yannic-metz', youtube: 'l8qllTq2aAk', name: 'Yannic Metz',
    eyebrow: { en: 'Episode 02 · Yannic Metz · Creative Dock', hu: '02. epizód · Yannic Metz · Creative Dock' },
    title: { en: "Two founders don't need culture", hu: 'Két alapítónak nem kell kultúra' },
    blurb: {
      en: 'He used to build everything himself, then helped teams build. Now AI has him prototyping again. Yannic on when culture starts to matter, and what he offers early hardware teams.',
      hu: 'Régen mindent maga épített, aztán csapatoknak segített építeni. Most a mesterséges intelligencia miatt újra prototípusokat készít. Yannic arról, mikor kezd számítani a kultúra, és mit kínál a korai hardveres csapatoknak.',
    },
  },
  {
    slug: 'steven-antalics', youtube: '1BYTsZtyBic', name: 'Steven Antalics',
    eyebrow: { en: 'Episode 01 · Steven Antalics · EkoHaul', hu: '01. epizód · Steven Antalics · EkoHaul' },
    title: { en: 'A sunny roof and a twenty-year-old idea', hu: 'Egy napsütötte tető és egy húszéves ötlet' },
    blurb: {
      en: 'Meet EkoHaul founder Steven Antalics: solar race cars, a twenty-year-old idea, and a pilot partner for powering parked trucks.',
      hu: 'Ismerd meg Steven Antalicsot, az EkoHaul alapítóját: napelemes versenyautók, egy húszéves ötlet, és egy pilot partner a parkoló kamionok energiaellátásához.',
    },
  },
];
---
<section id="conversations"><div class="wrap">
  <div class="section-heading"><h2><span class="en">BHW Conversations</span><span class="hu">BHW beszélgetések</span></h2><a class="text-link" href="/conversations/"><span class="en">Explore the series →</span><span class="hu">A sorozat →</span></a></div>
  <p class="conversation-intro"><span class="en">Meet the people behind the hardware. Ideas, detours and what it takes to make them work.</span><span class="hu">Ismerd meg a hardver mögött álló embereket: ötletek, kitérők és a megvalósítás kihívásai.</span></p>
  <div class="conversation-gallery">
    {episodes.map((ep) => (
      <article class="conversation-feature">
        <div class="conversation-cover">
          <iframe src={`https://www.youtube-nocookie.com/embed/${ep.youtube}`} title={`${ep.name} full interview · Budapest Hardware Club`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <div><p class="eyebrow"><span class="en">{ep.eyebrow.en}</span><span class="hu">{ep.eyebrow.hu}</span></p>
          <h3><a href={`/conversations/${ep.slug}/`}><span class="en">{ep.title.en}</span><span class="hu">{ep.title.hu}</span></a></h3>
          <p><span class="en">{ep.blurb.en}</span><span class="hu">{ep.blurb.hu}</span></p>
          <div class="conversation-actions"><a class="text-link" href={`/conversations/${ep.slug}/`}><span class="en">Read the article →</span><span class="hu">A cikk elolvasása →</span></a><a class="text-link" href={`https://youtu.be/${ep.youtube}`}><span class="en">Watch on YouTube ↗</span><span class="hu">Megtekintés a YouTube-on ↗</span></a></div>
        </div>
      </article>
    ))}
  </div>
</div></section>
