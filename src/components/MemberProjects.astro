---
import projects from '../data/memberProjects.json';
const published = projects.filter((project) => project.published);
const featured = published[0];
const others = published.slice(1);
---
{featured && (
  <section class="member-projects-home" id="member-projects" aria-labelledby="member-projects-heading">
    <div class="wrap">
      <div class="section-heading">
        <h2 id="member-projects-heading"><span class="en">Member projects</span><span class="hu">Tagjaink projektjei</span></h2>
        <a class="text-link" href="/projects/"><span class="en">Explore the gallery →</span><span class="hu">Projektek megtekintése →</span></a>
      </div>
      <article class="project-spotlight">
        <a class="project-spotlight-media" href={'/projects/' + featured.slug + '/'} aria-label={'Explore ' + featured.name}>
          <img src={featured.image} alt={featured.imageAlt} loading="lazy" decoding="async" width="1200" height="587" />
        </a>
        <div class="project-spotlight-body">
          <p class="eyebrow"><span class="en">Featured project · {featured.category.en}</span><span class="hu">Kiemelt projekt · {featured.category.hu}</span></p>
          <h3><a href={'/projects/' + featured.slug + '/'}>{featured.name}</a></h3>
          <p class="project-maker"><span class="en">By </span><span class="hu">Készítette: </span>{featured.creator}</p>
          <p class="project-summary en">{featured.summary.en}</p>
          <p class="project-summary hu">{featured.summary.hu}</p>
          <ul class="project-tags" aria-label="Technologies">
            {featured.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
          </ul>
          <a class="text-link project-explore" href={'/projects/' + featured.slug + '/'}>
            <span class="en">See the project →</span><span class="hu">Projekt megtekintése →</span>
          </a>
        </div>
      </article>
      {others.length > 0 && (
        <div class="project-spotlight-more">
          {others.map((project) => (
            <article class="project-spotlight-mini">
              <a class="project-spotlight-mini-media" href={'/projects/' + project.slug + '/'} aria-label={'Explore ' + project.name}>
                <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" />
              </a>
              <div class="project-spotlight-mini-body">
                <p class="eyebrow"><span class="en">{project.category.en}</span><span class="hu">{project.category.hu}</span></p>
                <h3><a href={'/projects/' + project.slug + '/'}>{project.name}</a></h3>
                <p class="project-maker"><span class="en">By </span><span class="hu">Készítette: </span>{project.creator}</p>
                <p class="en">{project.summary.en}</p>
                <p class="hu">{project.summary.hu}</p>
                <a class="text-link" href={'/projects/' + project.slug + '/'}><span class="en">Explore project →</span><span class="hu">Projekt megtekintése →</span></a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
)}
