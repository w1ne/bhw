---
import { getCollection } from 'astro:content';
const posts = (await getCollection('news')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const photos = { 'agent-control-deck-hackathon': '/images/hackathon-cover.jpg', 'meetup-1-build-before-the-hardware-arrives': '/images/recap-community-1.jpg' };
---
<section id="news"><div class="wrap">
  <div class="section-heading"><h2><span class="en">Recent events</span><span class="hu">Korábbi események</span></h2><a class="text-link" href="/news/"><span class="en">All reports →</span><span class="hu">Összes beszámoló →</span></a></div>
  <div class="event-grid">{posts.slice(0,2).map(post => <article class="event-story">
    <a class="event-photo" href={`/news/${post.slug}/`}><img src={photos[post.slug]} alt={post.data.title} width="1600" height="1067" loading="lazy" /></a>
    <p class="event-date"><time datetime={post.data.date.toISOString().slice(0,10)}><span class="en">{post.data.date.toLocaleDateString('en-GB', {day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</span><span class="hu">{post.data.date.toLocaleDateString('hu-HU', {day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</span></time></p>
    <h3><a href={`/news/${post.slug}/`}><span class="en">{post.data.title}</span><span class="hu">{post.data.titleHu}</span></a></h3>
    <p><span class="en">{post.data.description}</span><span class="hu">{post.data.descriptionHu}</span></p>
  </article>)}</div>
</div></section>
